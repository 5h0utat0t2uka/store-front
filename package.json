{
  "name": "store-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x",
    "pnpm": "12.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "sops exec-env --same-process .enc.env 'next dev'",
    "build": "sops exec-env --same-process .enc.env 'next build'",
    "start": "sops exec-env --same-process .enc.env 'next start'",
    "shopify:check": "sops exec-env --same-process .enc.env 'node scripts/check-storefront.mjs'"
  },
  "dependencies": {
    "gen-interface-jp": "0.8.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@shopify/cli": "5.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "^7.0.2"
  }
}
